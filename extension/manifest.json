{
  "manifest_version": 3,
  "name": "Flow × Rosterly",
  "version": "1.9.0",
  "description": "Prompt presets and one-click saving of Google Flow images into Rosterly channels.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://*.googleusercontent.com/*",
    "http://127.0.0.1:8022/*",
    "http://localhost:8022/*"
  ],
  "action": {},
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
